# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and local configuration
.venv/
venv/
.env
.env.*
!.env.example

# Notebook checkpoints
.ipynb_checkpoints/

# Local datasets and model artifacts; keep their documentation versioned
/data/*
!/data/README.md
/model/*
!/model/README.md

# Version evaluation reports while keeping serialized models ignored
!/model/reports/
/model/reports/**
!/model/reports/**/
!/model/reports/**/metrics.json
!/model/reports/**/classification_report.json
!/model/reports/**/cv_scores.csv
!/model/reports/**/confusion_matrix.png
!/model/reports/**/metadata.json

# MLflow experiment outputs
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*

# Build and test outputs
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Local logs and editor files
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db

# Preserved local files from the earlier repository cleanup
.local-archive/
